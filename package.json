    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
