{
  "outputDirectory": "doc_build",
  "redirects": [
    {
      "source": "/zh-hans/projects",
      "destination": "/zh-hans/opensource-projects/",
      "permanent": true
    },
    {
      "source": "/zh-hans/projects/:path*",
      "destination": "/zh-hans/opensource-projects/:path*",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/opensource-projects/",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/opensource-projects/:path*",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "CN"
        }
      ],
      "destination": "https://onixbyte.cn/:path*",
      "permanent": false
    }
  ]
}
